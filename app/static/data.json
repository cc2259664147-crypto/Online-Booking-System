{
  "diseases": {
    "感冒": {
      "desc": "感冒是一种常见的上呼吸道感染。",
      "symptoms": "流鼻涕、鼻塞、咳嗽、咽痛",
      "advice": "多喝水，注意休息，必要时服用感冒药"
    },
    "发烧": {
      "desc": "发烧是体温升高的表现。",
      "symptoms": "体温升高、乏力、头痛",
      "advice": "及时测量体温，超过38.5℃建议就医"
    },
    "咳嗽": {
      "desc": "咳嗽是呼吸道刺激反应。",
      "symptoms": "干咳或有痰、喉咙不适",
      "advice": "避免冷空气刺激，持续咳嗽需检查"
    },
    "头痛": {
      "desc": "头痛是常见症状之一。",
      "symptoms": "头部胀痛、压迫感",
      "advice": "保证休息，避免长时间用眼"
    },
    "腹泻": {
      "desc": "腹泻多由饮食问题或感染引起。",
      "symptoms": "频繁排便、腹痛",
      "advice": "补充水分，严重时就医"
    },
    "高血压": {
      "desc": "高血压是一种慢性疾病。",
      "symptoms": "头晕、头痛、心悸",
      "advice": "低盐饮食，规律服药"
    },
    "糖尿病": {
      "desc": "糖尿病是血糖异常升高的代谢疾病。",
      "symptoms": "多饮、多尿、多食、体重下降",
      "advice": "控制饮食，定期监测血糖"
    }
  },

  "facilities": {
    "自动体外除颤仪（AED）": {
      "desc": "用于心脏骤停急救。",
      "usage": "按照语音提示贴电极并进行电击",
      "note": "使用前确认患者无意识无呼吸"
    },
    "心电图机": {
      "desc": "检测心脏电活动。",
      "usage": "连接电极记录心电信号",
      "note": "需保持身体放松"
    },
    "血压计": {
      "desc": "用于测量血压。",
      "usage": "绑在手臂上自动测量",
      "note": "测量前需静坐5分钟"
    },
    "呼吸机": {
      "desc": "用于辅助或替代呼吸。",
      "usage": "通过面罩或插管供氧",
      "note": "需专业人员操作"
    },
    "CT扫描仪": {
      "desc": "用于医学影像检查。",
      "usage": "躺在扫描床上进行扫描",
      "note": "避免金属物品"
    },
    "核磁共振（MRI）": {
      "desc": "用于高精度影像检查。",
      "usage": "进入磁场进行扫描",
      "note": "体内金属需提前说明"
    }
  }
}